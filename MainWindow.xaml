                                        <Button x:Name="btnAddDamage1" Margin="5,0,3,0" Height="15" Width="15" Content="+" Click="btnAddDamage1_Click"/>
                                        <Button x:Name="btnSubtractDamage1" Margin="3,0,5,0" Height="15" Width="15" Content="-" Click="btnSubtractDamage1_Click"/>
