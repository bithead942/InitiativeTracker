                                    <Image x:Name="btnDelete1" Source="/Delete.jpg" Width="18" Height="18" Margin="1,0" MouseDown="btnDelete1_MouseDown" Cursor="Hand"/>
                                </StackPanel>
                                <CheckBox x:Name="Lock1"  Content="Lock" HorizontalAlignment="Center" Grid.Column="2" Grid.Row="0" IsChecked="True" VerticalAlignment="Center" Click="Lock1_Clicked"/>
                                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                                    <StackPanel Orientation="Horizontal">
                                        <!--Always Visible-->
                                        <TextBlock VerticalAlignment="Center"><Run Text="Init:"/></TextBlock>
